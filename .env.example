# Supabase (public)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SITE_URL=https://mibale.app
# Social logins enabled in Supabase (Authentication → Providers), e.g. google,apple. Empty = email only.
VITE_AUTH_PROVIDERS=
# 1 = every account must verify a mobile number by SMS (needs Supabase → Auth → Phone provider, e.g. Twilio)
VITE_PHONE_VERIFICATION=
# Code channels, first = default: sms | whatsapp,sms (WhatsApp needs an approved Twilio WhatsApp sender)
VITE_OTP_CHANNELS=sms
# Google Places key for address autocomplete (browser key, restricted by site + to "Places API (New)").
# Empty → free OpenStreetMap suggestions.
VITE_GOOGLE_MAPS_KEY=

# Server only (never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=

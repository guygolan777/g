# Supabase (public)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_SITE_URL=https://mibale.app
# Social logins enabled in Supabase (Authentication → Providers), e.g. google,apple. Empty = email only.
VITE_AUTH_PROVIDERS=
# 1 = every account must verify a mobile number by SMS (needs Supabase → Auth → Phone provider, e.g. Twilio)
VITE_PHONE_VERIFICATION=

# Server only (never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
PUSH_WEBHOOK_SECRET=
